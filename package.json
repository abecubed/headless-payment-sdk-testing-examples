{
  "name": "payment-sdk-middleware-qa-scenarios",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:governance": "node --experimental-strip-types scripts/verify-agent-guardrails.ts",
    "agent:explore": "node --experimental-strip-types scripts/autonomous-payment-agent.ts",
    "test:ci": "npm run test:governance && npm run typecheck && playwright test --reporter=list",
    "test:all": "npm run test:governance && npm run typecheck && npm test && npm run agent:explore"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
